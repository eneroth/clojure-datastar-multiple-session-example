{:paths ["src/main"]

 :deps {org.clojure/clojure        {:mvn/version "1.12.4"}
        dev.data-star.clojure/sdk  {:mvn/version "1.0.0-RC11"}
        dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}
        ring/ring-jetty-adapter    {:mvn/version "1.13.0"}
        metosin/reitit             {:mvn/version "0.7.2"}
        dev.onionpancakes/chassis  {:mvn/version "1.0.365"}
        com.cnuernber/charred      {:mvn/version "1.034"}
        co.multiply/quiescent      {:mvn/version "0.11.5"}

        ;; dev helpers
        io.github.tonsky/clj-reload {:mvn/version "0.7.1"}}

 :aliases
 {:repl {:extra-paths ["src/dev"]
         :extra-deps  {nrepl/nrepl            {:mvn/version "1.3.0"}
                       cider/cider-nrepl      {:mvn/version "0.50.2"}
                       co.multiply/remontoire {:mvn/version "0.7.4"}}}
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]}}}
